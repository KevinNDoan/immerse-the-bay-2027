* text=auto
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text=auto eol=lf
*.mat text eol=lf

# Git LFS: binary/source media stays available locally; Git stores pointers.
# Bracketed extensions also match uppercase filenames exported by art tools.
# Keep scripts, scenes, prefabs, materials, .meta, and ordinary .asset files as text.

# Models
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
*.[dD][aA][eE] filter=lfs diff=lfs merge=lfs -text
