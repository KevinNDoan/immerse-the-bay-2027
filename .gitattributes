*.[gG][lL][tT][fF] filter=lfs diff=lfs merge=lfs -text
*.[aA][bB][cC] filter=lfs diff=lfs merge=lfs -text
*.[uU][sS][dD] filter=lfs diff=lfs merge=lfs -text
*.[uU][sS][dD][cC] filter=lfs diff=lfs merge=lfs -text
*.[uU][sS][dD][zZ] filter=lfs diff=lfs merge=lfs -text

