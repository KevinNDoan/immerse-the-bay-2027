# Editor recovery and temporary assets (ignore their metadata too)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/[Aa]ssets/**/*.blend[0-9]
/[Aa]ssets/**/*.blend[0-9].meta

# IDE-generated files
.vs/
.idea/
.vscode/
.consulo/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
