*.mdb.meta

# Temporary files and crash reports
*.log
*.tmp
sysinfo.txt
mono_crash.*
.dirstamp
tmpinst-dir.stamp
crashlytics-build.properties

# Build output and local signing credentials
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
/*.app/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
*.keystore
*.jks

# Android build tooling generates these beside plug-ins
/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
/[Aa]ssets/Plugins/Android/**/local.properties

# OS files
.DS_Store
Thumbs.db

# Keep Assets (including .meta files), Packages, and ProjectSettings in source control.
# Local service credentials
.env
.env.local
.env.*.local
