{
  "mcpServers": {
    "satie": {
      "type": "http",
      "url": "https://www.satie.world/mcp"
    },
    "unity": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpforunityserver==10.3.0",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
