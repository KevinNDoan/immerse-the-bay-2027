# standin (default) or live
ORBIS_MODE=

# Reactor API key; required when ORBIS_MODE=live
REACTOR_API_KEY=

# Orbis model; default reactor/visko-orbis-stable
ORBIS_MODEL=

# Listen port; default 8787
RELAY_PORT=

# Optional delivery tier advertised by Orbis (empty keeps deployment default)
ORBIS_RESOLUTION=
# Bound JPEG decoding work on Quest (default 1280, range 320..1920)
RELAY_MAX_WIDTH=
# Local transcription model; downloaded once, no API key (default base.en)
SPEECH_MODEL=
# Optional: semantic edits, summaries and world prompts
OPENAI_API_KEY=
NODE_MODEL=

# Starting 360 image using the existing OpenAI key. Unset defaults to gpt-image-2;
# explicitly empty disables image preparation. Orbis generates the live world.
PANORAMA_MODEL=gpt-image-2
WORLD_LABS_API_KEY=
# Optional additional funded accounts for explicitly authorized one-world preparation jobs.
# Only scripts/probe_worldlabs.py --key-env reads these; the demo server never loads them.
WORLD_LABS_API_KEY_2=
WORLD_LABS_API_KEY_3=
WORLD_LABS_MODEL=marble-1.1
# auto uses geometry when a World Labs key exists; orbis keeps the video experiment.
WORLD_PROVIDER=auto
# Disabled by default; one existing test world can serve every topic without new World Labs jobs.
WORLD_GENERATION_ENABLED=false
WORLD_TEST_WORLD_ID=
